# Postgres connection (required)
DATABASE_URL=postgresql://user:pass@localhost:5432/agenticops

# Server
PORT=3001
NODE_ENV=development

# ── Phase 0: security ──

# AES-256-GCM key for secrets-at-rest. Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Bootstrap admin token. On first boot (when no admin exists), this raw token
# is hashed and installed as the initial admin. Use it to mint per-user tokens
# via POST /api/tokens, then rotate this out.
APP_BOOTSTRAP_ADMIN_TOKEN=

# Comma-separated list of allowed CORS origins.
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Phase 2: agent-driven IaC remediation ──

# Anthropic API key for the IaC remediation agent. If unset, the runner still
# does plan/apply but does not propose patches.
ANTHROPIC_API_KEY=

# ── GitHub OAuth (used for both repo connection and user login) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/github/callback

# Public app URL used to construct webhook + OAuth callback URLs.
APP_URL=http://localhost:3001

# ── GitHub login: role mapping (Phase-7 user-facing login) ──
# Comma-separated GitHub usernames. Anyone not listed defaults to 'viewer'.
GITHUB_ADMIN_USERS=
GITHUB_OPERATOR_USERS=
# Optional: explicit allowlist. When set, anyone NOT in this list is denied
# at login (they get a 403 page). Leave empty to allow any GitHub user (with
# default role 'viewer' unless they're in admins/operators above).
GITHUB_ALLOWED_USERS=

# ── OIDC SSO (per-config; managed via /api/oidc admin endpoint) ──
# Confidential OIDC clients require a secret at the token endpoint. We don't
# store it in the DB — set per-config via env. Naming:
#   OIDC_CLIENT_SECRET_<UPPERCASE_CONFIG_ID_WITH_NON_ALPHANUM_AS_UNDERSCORE>
# e.g. config id=oidc-1234 → OIDC_CLIENT_SECRET_OIDC_1234
# Public OIDC clients (PKCE only, no secret) work with no env var.

# ── Audit log retention (days, default 365) ──
AUDIT_RETENTION_DAYS=365
